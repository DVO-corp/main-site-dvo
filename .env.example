# DVO Corp site — environment variables
#
# Every variable here is optional. The site builds and deploys with none of
# them set; they exist so integrations can be switched on without code changes.
# Copy to `.env.local` for local development.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the static bundle at build time
# and are therefore public. Never put a secret here.

# Endpoint the contact form POSTs to. Leave empty to keep the form in demo
# mode, where nothing is sent and the visitor is shown the Telegram/email
# fallback instead. Example: https://api.dvocorp.com/lead
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Domain registered in Plausible. Leave empty to ship no analytics at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
